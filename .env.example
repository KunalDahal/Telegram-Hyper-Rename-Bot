# ================================
# Telegram API
# ================================

API_ID=
API_HASH=
BOT_TOKEN=


# ================================
# Database
# ================================

MONGO_URI=
MONGO_DB_NAME=renamer_bot


# ================================
# Bot / Owner
# ================================

OWNER_IDS=
BOT_DUMP_CHAT_ID=


# ================================
# Concurrency
# ================================

# Number of complete jobs that can run at the same time
WORKERS=3

# Number of Telegram file parts uploaded concurrently
# per individual upload
UPLOAD_PART_WORKERS=8


# ================================
# Optional: Access Control
# ================================

# Comma-separated Telegram group IDs
# Leave empty to allow normal configured behavior
ALLOWED_GROUP_IDS=


# ================================
# Optional: Sub Bots
# ================================

# Comma-separated bot tokens
SUB_BOT_TOKENS=


# ================================
# Optional: Telegram Sessions
# ================================

BOT_SESSION_STRING=
SESSION_STRING=


# ================================
# Optional: Dump Chat
# ================================

DUMP_CHAT_ID=


# ================================
# Optional: Command Configuration
# ================================

# 0 = disabled
# 1 = enabled
COMMAND_POSTFIX=0